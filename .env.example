# Server-only environment for the Pflegedokumentation simulator.
# Copy to .env.local for development. Never commit real values.

# Local development database (libSQL file). Ignored by git.
DATABASE_URL=file:./.local/dev.db

# Turso Cloud (production / shared database). Server-side only, never NEXT_PUBLIC_.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Pepper for stored session-token hashes. At least 32 characters.
SESSION_SECRET=

# scrypt hash of the teacher password: scrypt$N$r$p$salt$hash
# Generate with: npm run hash-password -- --write
TEACHER_PASSWORD_HASH=

# Optional display name shown to the teacher.
TEACHER_DISPLAY_NAME=Lehrkraft

# Public origin of the app, used for the cookie/origin checks.
APP_ORIGIN=http://localhost:3000
